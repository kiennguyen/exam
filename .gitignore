# env files (can opt-in for committing if needed)
.env*

# Local IOE imports (copyrighted source material — do not commit)
/data/imported/
/public/ioe-media/**
!/public/ioe-media/audio/
!/public/ioe-media/audio/**
!/public/ioe-media/images/
!/public/ioe-media/images/**

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
