{
  "name": "vaijob-exam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3020",
    "dev:default-port": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "validate:exams": "tsx scripts/validate-exams.ts",
    "import:ioe": "tsx scripts/import-ioe-docx.ts",
    "import:report": "tsx scripts/import-report.ts",
    "ioe:template": "tsx scripts/ioe/generate-answer-template.ts",
    "ioe:answers-from-csv": "tsx scripts/ioe/import-answers-csv.ts",
    "ioe:parse-answers": "tsx scripts/ioe/parse-answer-docx.ts",
    "ioe:audit-gaps": "tsx scripts/ioe/audit-answer-gaps.ts",
    "ioe:build": "tsx scripts/ioe/build-exam-from-import.ts",
    "ioe:publish-all": "npm run ioe:parse-answers && npm run ioe:build -- --all --status published && npm run ioe:sync-collection && npm run validate:exams",
    "ioe:extract-media": "tsx scripts/ioe/extract-docx-media.ts",
    "ioe:media-report": "tsx scripts/ioe/report-media-questions.ts",
    "ioe:sync-collection": "tsx scripts/ioe/sync-collection.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "mammoth": "^1.11.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
